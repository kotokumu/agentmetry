{
  "name": "agentmetry-desktop",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "tauri": "tauri",
    "web:build": "npm --prefix web run build",
    "desktop:icons": "tauri icon assets/brand/agentmetry-mark.png",
    "desktop:inputs": "npm run desktop:icons && npm run web:build && node build/desktop/build-sidecar.mjs",
    "desktop:test": "node --test build/*.test.mjs build/desktop/*.test.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:macos": "tauri build --bundles app && node build/desktop/package-macos-dmg.mjs",
    "desktop:build:windows": "tauri build --bundles nsis",
    "desktop:build:linux": "tauri build --bundles appimage,deb"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0"
  }
}
