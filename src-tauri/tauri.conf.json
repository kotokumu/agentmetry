{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentmetry",
  "version": "1.10.3",
  "identifier": "com.theoden.agentmetry",
  "build": {
    "beforeDevCommand": "npm run desktop:inputs",
    "beforeBuildCommand": "npm run desktop:inputs"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/agentmetry"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMkQ5OTAzRTBDMzlEQzIKUldUQ25jUGdBNWt0RTY1OU8xc2tPSWUxWEJsRW9xWnVsZ29oRXJ0eS92T2thUnM2K3F5Z0dQeG8K",
      "endpoints": [
        "https://github.com/kotokumu/agentmetry/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
